{
  "name": "contentpulse",
  "version": "0.1.0",
  "description": "ContentPulse — Semantic Decay & Freshness Engine (monorepo)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test:core && npm run test:contentful && npm run test:payload && npm run test:cli",
    "test:core": "npm run test --workspace=packages/core",
    "test:cli": "npm run test --workspace=packages/cli",
    "test:contentful": "npm run test --workspace=packages/contentful",
    "test:payload": "npm run test --workspace=packages/payload"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
